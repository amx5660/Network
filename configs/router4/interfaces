# interfaces(5) file used by ifup(8) and ifdown(8)
# Include files from /etc/network/interfaces.d:
source /etc/network/interfaces.d/*

auto lo
iface lo inet loopback

auto eth0
iface eth0 inet static
 address 10.192.0.2
 netmask 255.255.192.0
 up ip route add 10.0.0.0/10 via 10.192.0.1
 down ip route del 10.0.0.0/10 via 10.192.0.1

 up ip route add 10.64.0.0/10 via 10.192.0.1
 down ip route del 10.64.0.0/10 via 10.192.0.1

 up ip route add 10.128.0.0/10 via 10.192.0.1
 down ip route del 10.128.0.0/10 via 10.192.0.1

auto eth1
iface eth1 inet dhcp
