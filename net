#!/usr/bin/env bash

start_containers() {
	for container in $containers_list; do
		lxc-start -n $container
		echo "$container started"
	done
	return 0
}

stop_containers() {
	for container in $containers_list; do
		lxc-stop -n $container
		echo "$container stopped"
	done
	return 0
}

repair_containers() {
	for container in $containers_list; do
		lxc-attach -n $container -- systemctl restart networking
		echo "$container repaired"
	done
	return 0
}

initialization() {
	return 0
}

containers_list=$(lxc-ls)

for arg in "$@"; do
	case $arg in
		"init")
		echo "---Initializing containers---"
		initialization
		;;&

		"start")
		echo "---Starting containers---"
		start_containers
		;;&

		"repair")
		echo "---Repairing containers---"
		repair_containers
		;;&

		"stop")
		echo "---Stopping containers---"
		stop_containers
		;;&
	esac

done
