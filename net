#!/usr/bin/env bash

if [[ $UID -ne 0 ]]; then
   echo "This script requires superuser privileges (sudo)."
   exit 1
fi

start_containers() {
	for container in $containers_list; do
		lxc-start -n $container
		echo "$container started"
	done
	return 0
}

stop_containers() {
	for container in $containers_list; do
		lxc-stop -n $container
		echo "$container stopped"
	done
	return 0
}

repair_containers() {
	for container in $containers_list; do
		lxc-attach -n $container -- systemctl restart networking
		echo "$container repaired"
	done
	return 0
}

destroy_containers() {
	for container in $containers_list; do
		lxc-destroy -n $container
		echo "$container destroyed"
	done
	return 0;
}

packages_install() {
	local packages=$(cat "./Setup/packages" | tr "\n" " ")

	for package in $packages; do
		if ! dpkg -s "$package" > /dev/null; then
			local response

			echo ""
			read -r -p "Do you want to install  $package? [Y/n] " response

			case "$response" in "" | "y" | "Y") apt update
							    apt install -y "$package";;
						         *) echo "Abort"
							    return 1;;
			esac
		fi
	done
	return 0
}

containers_creation() {
	for container in $(ls ./configs); do
		local packages=$(cat "./configs/$container/packages" | tr "\n" " ")

		lxc-create -n "$container" -t download -- --dist debian --release trixie --arch amd64
		lxc-start -n "$container"
		lxc-attach -n "$container" -- bash -c "apt update && apt install -y $packages"
		lxc-stop -n "$container"

	done

	return 0
}

bridges_configuration() {
	cp "./Setup/interfaces" "/etc/network/interfaces"
	systemctl restart networking
	return 0;
}


containers_configuration(){
	for container in $(ls ./configs); do

		if [[ -f "./configs/$container/config" ]]; then
			cp "./configs/$container/config" "/var/lib/lxc/$container/config"
		fi

		if [[ -f "./configs/$container/interfaces" ]]; then
			cp "./configs/$container/interfaces" "/var/lib/lxc/$container/rootfs/etc/network/interfaces"
		fi

		if [[ -f "./configs/$container/resolved.conf" ]]; then
			cp "./configs/$container/resolved.conf" "/var/lib/lxc/$container/rootfs/etc/systemd/resolved.conf"
		fi

		if [[ -f "./configs/$container/iptables" ]]; then
			cp "./configs/$container/iptables" "/var/lib/lxc/$container/rootfs/etc/iptables/rules.v4"
		fi

		if [[ -f "./configs/$container/named.conf.local" ]]; then
			cp "./configs/$container/named.conf.local" "/var/lib/lxc/$container/rootfs/etc/bind/named.conf.local"
		fi

		if [[ -f "./configs/$container/named.conf.options" ]]; then
			cp "./configs/$container/named.conf.options" "/var/lib/lxc/$container/rootfs/etc/bind/named.conf.options"
		fi

		if [[ -f "./configs/$container/db.potato" ]]; then
			cp "./configs/$container/db.potato" "/var/lib/lxc/$container/rootfs/etc/bind/db.potato"
		fi

	done

	return 0
}

containers_list=$(lxc-ls)

for arg in "$@"; do
	case "$arg" in
		"init")
		echo "---Initializing containers---"
		packages_install || exit 1
		bridges_configuration
		containers_creation
		containers_configuration
		;;&

		"start")
		echo "---Starting containers---"
		start_containers
		;;&

		"repair")
		echo "---Repairing containers---"
		repair_containers
		;;&

		"stop")
		echo "---Stopping containers---"
		stop_containers
		;;&

		"destroy")
		echo "---Destroying containers---"
		destroy_containers
		;;&
	esac

done
